# compose.prod.yml bu dosyanin `.env` adli kopyasini okur.
# `.env` gitignore'da: gercek degerler depoya girmez.
#   cp .env.example .env

# Zorunlu. Uret:
#   python3 -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Uretimde her zaman False. Acik birakilirsa hata sayfasi ayarlari ve
# veritabani parolasini isteyen herkese gosterir.
DJANGO_DEBUG=False

# Zorunlu. Uygulamaya hangi isimlerle erisiliyorsa hepsi, virgulle ayrilmis.
DJANGO_ALLOWED_HOSTS=mind.ornek.com,192.0.2.10

# TLS kurulduktan sonra True yap. Once sertifika, sonra bu satir: duz http
# uzerinde True yapmak sonsuz yonlendirme dongusu uretir.
DJANGO_HTTPS=False

# DJANGO_HTTPS=True iken gerekli; sema ile birlikte yazilir.
DJANGO_CSRF_TRUSTED_ORIGINS=https://mind.ornek.com

# Veritabani. Parola zorunlu; ilk `up` bu parolayla veritabanini olusturur,
# sonradan degistirmek icin volume'u silmek ya da ALTER USER gerekir.
POSTGRES_DB=mind-db
POSTGRES_USER=cerberus
POSTGRES_PASSWORD=

# nginx'in host uzerinde dinledigi port.
HTTP_PORT=80
